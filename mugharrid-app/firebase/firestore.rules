rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المشرف: وجود مستند admins/<uid> يُنشأ يدوياً من لوحة Firebase.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }

    // محتوى التطبيق من لوحة التحكم: قراءة للجميع، كتابة للمشرف فقط.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // بيانات كل مستخدم: صاحبها يقرؤها ويكتبها لكن لا يستطيع فك الإيقاف عن نفسه. المشرف يدير الحسابات.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && !('blocked' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('blocked', false) == resource.data.get('blocked', false);
      allow update, delete: if isAdmin();
    }

    // الملف العام للصداقة: الاسم وكود الصداقة فقط.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // غرف التدرب بين صديقين: لا يدخلها إلا عضواها.
    match /rooms/{roomId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 2;
      // الانضمام لمجموعة دراسية برمز الدعوة: يضيف المستخدم نفسه فقط، وبحد أقصى 20 عضواً.
      allow update: if request.auth != null
        && resource.data.group == true
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 20
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'lastAt']);

      match /{sub}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
      }
    }

    // الدوري الأسبوعي: الكل يقرأ الترتيب، وكل مستخدم يكتب نتيجته فقط.
    match /league/{week}/scores/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.score is int && request.resource.data.score <= 5000;
    }

    // رموز دعوة المجموعات: تُقرأ بالرمز، وينشئها صاحب المجموعة.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow list, update, delete: if false;
    }

    // أكواد الاشتراك: تُنشأ وتُحذف من لوحة Firebase فقط.
    match /codes/{code} {
      // المستخدم يقرأ كوداً واحداً يعرف نصه، ولا يستطيع استعراض قائمة الأكواد.
      allow get: if request.auth != null;
      allow list, create, delete: if false;

      // التفعيل: مرة واحدة فقط، ولحساب المستخدم نفسه، ودون تغيير مدة الكود.
      allow update: if request.auth != null
        && (!('usedBy' in resource.data) || resource.data.usedBy == '')
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedEmail']);
    }
  }
}
