{
  "manifest_version": 3,
  "name": "DIAMOND Voice Capture — التقاط الصوت المرجعي",
  "version": "1.3.1",
  "description": "التقط صوت أي تبويب أو الميكروفون كصوت مرجعي وأرسله إلى التطبيق المحلي أو خادم Colab.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "tabs",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7861/*",
    "https://*.trycloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "بدء/إيقاف التقاط صوت التبويب الحالي كمرجع"
    }
  }
}